generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  username      String?   @unique
  passwordHash  String?
  avatar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  profile       UserProfile?
  evidenceItems EvidenceItem[]
  generatedProfiles GeneratedProfile[]
  publicPageSettings PublicPageSettings?
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String?
  headline  String?
  location  String?
  website   String?
  github    String?
  linkedin  String?
  youtube   String?
  theme     String   @default("paper")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EvidenceItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  url         String?
  filename    String?
  fileUrl     String?
  title       String?
  description String?
  screenshot  String?
  rawContent  String?
  metadata    Json?
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GeneratedProfile {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PublicPageSettings {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isPublic  Boolean  @default(true)
  mode      String   @default("hiring")
  theme     String   @default("paper")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
