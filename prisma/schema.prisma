generator client {
  provider      = "prisma-client-js"
  compilerBuild = "small"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  username      String?   @unique
  passwordHash  String?
  avatar        String?
  planTier      String    @default("free")
  stripeCustomerId String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId  String?
  stripeProductId String?
  stripeSubscriptionStatus String?
  billingInterval String?
  subscriptionCurrentPeriodStart DateTime?
  subscriptionCurrentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  billingSyncedAt DateTime?
  aiProvider    String    @default("kimi")
  preferredAiModel String?
  aiUsageRate   String    @default("auto")
  agentPreferences Json?
  aiUsageCycleStartedAt DateTime @default(now())
  advancedAiCreditsUsed Int @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  profile       UserProfile?
  evidenceItems EvidenceItem[]
  generatedProfiles GeneratedProfile[]
  publicPageSettings PublicPageSettings?
  automations   Automation[]
  agentArtifacts AgentArtifact[]
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String?
  headline  String?
  location  String?
  website   String?
  github    String?
  linkedin  String?
  youtube   String?
  contactEmail String?
  phone     String?
  contactNote String?
  theme     String   @default("paper")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EvidenceItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  url         String?
  canonicalUrl String?
  filename    String?
  fileUrl     String?
  title       String?
  description String?
  screenshot  String?
  crawlStatus String   @default("ready")
  screenshotStatus String @default("unavailable")
  screenshotError String?
  rawContent  String?
  metadata    Json?
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, canonicalUrl])
}

model GeneratedProfile {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PublicPageSettings {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isPublic               Boolean  @default(true)
  visibility             String   @default("public")
  mode                   String   @default("hiring")
  theme                  String   @default("paper")
  themeConfig            Json?
  resumeModel            String   @default("executive")
  resumeModelConfig      Json?
  customDomain           String?
  customDomainNormalized String?  @unique
  customDomainStatus     String   @default("none")
  customDomainDnsStatus  String   @default("not_started")
  customDomainVerificationName String?
  customDomainVerificationValue String?
  customDomainProviderId String?
  customDomainProviderStatus String?
  customDomainSslStatus  String?
  customDomainProviderError String?
  customDomainLastCheckedAt DateTime?
  customDomainError      String?
  customDomainDiagnostics Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Automation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  action      String   // "recrawl_url" | "regenerate_profile" | "refresh_timeline" | "refresh_video_script"
  config      Json     // action-specific config e.g. { url: "https://..." }
  schedule    String   @default("weekly") // "daily" | "weekly" | "monthly"
  scheduleTime String  @default("09:00")
  scheduleTimezone String @default("UTC")
  enabled     Boolean  @default(true)
  lockedAt    DateTime?
  lastAttemptAt DateTime?
  lastRun     DateTime?
  nextRun     DateTime?
  lastStatus  String?  // "success" | "error" | "running"
  lastError   String?
  retryCount  Int      @default(0)
  runCount    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AgentArtifact {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool      String   // "timeline" | "video_script" | "tree" | "chat"
  style     String?  // e.g. "documentary" | "minimal" | "cinematic" for video; "vertical" | "horizontal" | "radial" for tree
  input     String?  @db.Text
  output    Json
  meta      Json?
  createdAt DateTime @default(now())
}

model StripeWebhookEvent {
  id               String   @id
  type             String
  status           String   @default("processing")
  livemode         Boolean
  eventCreatedAt   DateTime?
  userId           String?
  stripeCustomerId String?
  stripeSubscriptionId String?
  processedAt      DateTime?
  lastError        String?
  attemptCount     Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([userId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}
