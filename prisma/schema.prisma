generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  username      String?   @unique
  passwordHash  String?
  avatar        String?
  planTier      String    @default("free")
  aiProvider    String    @default("kimi")
  preferredAiModel String?
  aiUsageRate   String    @default("auto")
  aiUsageCycleStartedAt DateTime @default(now())
  advancedAiCreditsUsed Int @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  profile       UserProfile?
  evidenceItems EvidenceItem[]
  generatedProfiles GeneratedProfile[]
  publicPageSettings PublicPageSettings?
  automations   Automation[]
  agentArtifacts AgentArtifact[]
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String?
  headline  String?
  location  String?
  website   String?
  github    String?
  linkedin  String?
  youtube   String?
  theme     String   @default("paper")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EvidenceItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  url         String?
  filename    String?
  fileUrl     String?
  title       String?
  description String?
  screenshot  String?
  rawContent  String?
  metadata    Json?
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GeneratedProfile {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PublicPageSettings {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isPublic               Boolean  @default(true)
  visibility             String   @default("public")
  mode                   String   @default("hiring")
  theme                  String   @default("paper")
  themeConfig            Json?
  resumeModel            String   @default("executive")
  resumeModelConfig      Json?
  customDomain           String?
  customDomainNormalized String?  @unique
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Automation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  action      String   // "recrawl_url" | "regenerate_profile" | "refresh_timeline" | "refresh_video_script"
  config      Json     // action-specific config e.g. { url: "https://..." }
  schedule    String   @default("weekly") // "daily" | "weekly" | "monthly"
  enabled     Boolean  @default(true)
  lastRun     DateTime?
  nextRun     DateTime?
  lastStatus  String?  // "success" | "error" | "running"
  lastError   String?
  runCount    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AgentArtifact {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool      String   // "timeline" | "video_script" | "tree" | "chat"
  style     String?  // e.g. "documentary" | "minimal" | "cinematic" for video; "vertical" | "horizontal" | "radial" for tree
  input     String?  @db.Text
  output    Json
  createdAt DateTime @default(now())
}
